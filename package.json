{
  "name": "phoenix-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first infrastructure recovery verification platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @phoenix/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:nim": "vitest run packages/ai-provider/src --reporter=verbose",
    "test:repository": "vitest run packages/repository/src --reporter=verbose",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
